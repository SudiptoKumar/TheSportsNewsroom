{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The Sports Newsroom V4 Exa Selected Evidence Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_complete",
    "items"
  ],
  "properties": {
    "research_complete": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "post_number",
          "evidence",
          "source_urls",
          "source_names",
          "image_urls",
          "image_source_page_urls",
          "image_notes"
        ],
        "properties": {
          "post_number": {
            "type": "integer"
          },
          "evidence": {
            "type": "string"
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_source_page_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
