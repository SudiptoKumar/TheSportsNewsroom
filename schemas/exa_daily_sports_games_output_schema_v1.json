{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "calendar_date": {
      "type": "string"
    },
    "daily_complete": {
      "type": "boolean"
    },
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "post_number": {
            "type": "integer"
          },
          "sector": {
            "type": "string"
          },
          "normalized_subject": {
            "type": "string"
          },
          "central_knowledge_unit": {
            "type": "string"
          },
          "central_claim": {
            "type": "string"
          },
          "editorial_angle": {
            "type": "string"
          },
          "sport_or_game": {
            "type": "string"
          },
          "sport_or_game_category": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "main_story": {
            "type": "string"
          },
          "key_highlights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "why_it_is_interesting": {
            "type": "string"
          },
          "historical_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "historical_year": {
            "type": [
              "string",
              "null"
            ]
          },
          "historical_period": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "city_location": {
            "type": [
              "string",
              "null"
            ]
          },
          "people_involved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "date_relevance": {
            "type": "string"
          },
          "source_1": {
            "$ref": "#/$defs/source"
          },
          "source_2": {
            "$ref": "#/$defs/source"
          },
          "source_3": {
            "$ref": "#/$defs/source"
          },
          "image": {
            "$ref": "#/$defs/image"
          }
        },
        "required": [
          "post_number",
          "sector",
          "normalized_subject",
          "central_knowledge_unit",
          "central_claim",
          "editorial_angle",
          "sport_or_game",
          "sport_or_game_category",
          "topic",
          "headline",
          "main_story",
          "key_highlights",
          "why_it_is_interesting",
          "historical_date",
          "historical_year",
          "historical_period",
          "country",
          "region",
          "city_location",
          "people_involved",
          "date_relevance",
          "source_1",
          "source_2",
          "source_3",
          "image"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "calendar_date",
    "daily_complete",
    "posts"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "evidence_note": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "type",
        "evidence_note"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "image_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_page_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "alt_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "copyright": {
          "type": [
            "string",
            "null"
          ]
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "license_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "image_url",
        "source_page_url",
        "source_name",
        "source_type",
        "alt_text",
        "caption",
        "license",
        "copyright",
        "attribution",
        "license_status",
        "verification_status",
        "quality"
      ],
      "additionalProperties": false
    }
  }
}